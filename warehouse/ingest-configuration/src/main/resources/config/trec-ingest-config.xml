<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>

<!--
   Configuration for ingesting trec jsonl format:

   {"doc_id": "D1555982", "url": "https://foo.com",
    "title": "This is the title",
    "body": "This is the body\nWith embedded newlines"}
-->

<configuration>

    <property>
        <name>file.input.format</name>
        <value>datawave.ingest.json.mr.input.JsonInputFormat</value>
    </property>

    <property>
        <name>data.name</name>
        <value>trec</value>
    </property>

    <property>
        <name>trec.output.name</name>
        <value>trec</value>
        <description>This is the name to use on the data in Accumulo</description>
    </property>

    <property>
        <name>trec.ingest.helper.class</name>
        <value>datawave.ingest.json.config.helper.JsonIngestHelper</value>
    </property>

    <property>
        <name>trec.reader.class</name>
        <value>datawave.ingest.json.mr.input.JsonRecordReader</value>
    </property>

    <property>
        <name>trec.handler.classes</name>
        <value>datawave.ingest.json.mr.handler.ContentJsonColumnBasedHandler</value>
    </property>

    <property>
        <name>trec.data.category.uuid.fields</name>
        <value>DOC_ID</value>
    </property>

    <property>
        <name>trec.data.separator</name>
        <value>,</value>
    </property>

    <property>
        <name>trec.data.header</name>
        <value>URL,TITLE,BODY</value>
    </property>

    <property>
        <name>trec.data.process.extra.fields</name>
        <value>true</value>
    </property>

    <property>
        <name>trec.data.json.flattener.mode</name>
        <value>SIMPLE</value>
    </property>

    <property>
        <name>trec.data.category.marking.default</name>
        <value>PUBLIC</value>
    </property>

    <property>
        <name>trec.data.category.date</name>
        <value>NONE</value>
        <description>Known date field to be used, if found, for the shard row id. Otherwise, current date will be used
        </description>
    </property>

    <property>
        <name>trec.data.category.date.formats</name>
        <value>yyyy-MM-dd'T'HH:mm:ss'Z',yyyy-MM-dd HH:mm:ss</value>
        <description>Known/valid date formats *.data.category.date field</description>
    </property>

    <!-- Indexing and tokenization-->

    <property>
        <name>trec.data.category.index</name>
        <value>URL,TITLE,BODY</value>
        <description>List of known fields to index</description>
    </property>

    <property>
        <name>trec.data.category.index.reverse</name>
        <value>URL</value>
        <description>List of known fields to reverse index</description>
    </property>

    <property>
        <name>trec.data.category.token.fieldname.designator.enabled</name>
        <value>false</value>
        <description>Field name suffix to be applied to field names that are tokenized.
            See *.data.category.index.tokenize.allowlist
        </description>
    </property>

    <property>
        <name>trec.data.category.index.tokenize.allowlist</name>
        <value>TITLE,BODY</value>
        <description>These are the fields to tokenize and index.</description>
    </property>

    <property>
        <name>trec.data.category.index.only</name>
        <value>BODY</value>
        <description>Fields that will exist only in the global index. Will not be stored as part of the event
        </description>
    </property>

    <!-- Field Normalization -->

    <property>
        <name>trec.data.default.normalization.failure.policy</name>
        <value>FAIL</value>
        <description>For field normalization failures: DROP, LEAVE, FAIL.
            FAIL will cause the entire record to be dropped and written to the error schema in Accumulo
        </description>
    </property>

    <property>
        <name>trec.data.default.type.class</name>
        <value>datawave.data.type.LcNoDiacriticsType</value>
        <description>Default type</description>
    </property>
</configuration>
